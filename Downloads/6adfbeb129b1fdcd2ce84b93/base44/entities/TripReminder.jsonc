{
  "name": "TripReminder",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "sent_for": {
      "type": "string"
    },
    "sent_at": {
      "type": "string"
    },
    "to_email": {
      "type": "string"
    }
  },
  "required": [
    "trip_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}